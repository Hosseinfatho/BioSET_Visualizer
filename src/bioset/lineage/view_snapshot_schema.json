{
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "url": { "type": "string" },
    "created": { "type": "string" },
    "updated": { "type": "string" },
    "title": { "type": "string" },
    "notes": {
      "type": "string",
      "description": "Free text, summary, or report body. Exportable."
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "bookmark": { "type": "boolean" },
    "camera": {
      "type": "object",
      "properties": {
        "position": { "type": "array", "items": { "type": "number" } },
        "focalPoint": { "type": "array", "items": { "type": "number" } },
        "viewUp": { "type": "array", "items": { "type": "number" } }
      }
    },
    "channels": { "type": "array" },
    "active_channels": { "type": "array" },
    "background": { "type": "string" },
    "viewport": {
      "type": "object",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "optional_LOD": {
      "type": "object",
      "properties": {
        "component": { "type": "integer" },
        "roi": { "type": "object" }
      }
    },
    "groups": { "type": "array", "items": { "type": "string" } },
    "meta": {
      "type": "object",
      "description": "Optional: report items (e.g. report_items: [{ text, image }]), thumbnails, images. For summaries and exportable reports."
    }
  }
}
