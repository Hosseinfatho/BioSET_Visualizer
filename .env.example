ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Biomni Flask server. On Arcade Docker use the sibling container, not host :5000
# (host :5000 is vipsit). Local same-machine: leave unset → http://localhost:5000
# BIOSET_BIOMNI_URL=http://biomni:5000

# Globus HTTPS Zarr streaming (optional; used for globus:// or *.gaccess.io URLs).
# Defaults in config.py point at the Torch scratch collection; override per collection.
BIOSET_GLOBUS_CLIENT_ID=6be7e29d-6cf6-42a0-bf49-90ccba4bf8a3
BIOSET_GLOBUS_COLLECTION_ID=31fa4572-cd84-489b-8008-0bf0e52bb4d4
BIOSET_GLOBUS_HTTPS_BASE=https://m-b2c38a.183192.b160.gaccess.io
BIOSET_GLOBUS_TOKEN_FILE=~/.bioset/globus_token.json